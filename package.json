{
  "name": "mactrans",
  "version": "0.0.0",
  "private": true,
  "description": "Offline macOS Services and CLI translation using Apple's Translation framework.",
  "scripts": {
    "build": "./scripts/build.sh",
    "deploy": "./scripts/install.sh",
    "lint": "npx npm-run-all --parallel lint:*",
    "lint:swift": "swift format lint --recursive --strict Package.swift Sources scripts/make-icon.swift",
    "lint:shell": "shellcheck run.sh scripts/*.sh",
    "clean": "rm -rf .build Resources/AppIcon.iconset",
    "destroy": "pkill -f 'MacTrans.app/Contents/MacOS/MacTransService$' || true",
    "run:setup": "./run.sh",
    "run:make-icon": "swift scripts/make-icon.swift",
    "run:uninstall": "./scripts/uninstall.sh"
  }
}
